# --- Application ---
APP_NAME=AI Customer Care Bot
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL via psycopg) ---
DATABASE_URL=postgresql+psycopg://customer_care:customer_care@localhost:5432/customer_care

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=YOUR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP ---
OTP_EXPIRE_MINUTES=10
# Failed attempts before the OTP is invalidated (brute-force protection).
MAX_OTP_ATTEMPTS=5
# Dev only! Disable in production so OTPs are never returned in API responses.
EXPOSE_OTP_IN_RESPONSE=true

# --- Orders ---
# Flat shipping cost and sales-tax rate applied at checkout.
ORDER_SHIPPING_COST=4.99
ORDER_TAX_RATE=0.08

# --- Chat ---
# Bot reply backend: "stub" (offline placeholder) or "groq" (live LLM).
CHAT_REPLY_BACKEND=stub

# --- AI / Groq ---
# GROQ is the only LLM provider. Get a key at https://console.groq.com
# Never commit a real key; it is read from the environment at runtime.
GROQ_API_KEY=
# Model name is configurable without touching code.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Notifications ---
# Delivery channel: "noop" until email/SMS/WhatsApp/push providers are built.
NOTIFICATION_CHANNEL=noop

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
